# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Usernames are mapped to internal emails: <username>@<this domain>. Never sent anywhere.
# Must match the domain in public.handle_new_user() (migration 0006) — do not change alone.
VITE_AUTH_EMAIL_DOMAIN=users.challengegrind.local

# Optional: Cloudflare Turnstile site key (enable Captcha in Supabase Auth settings too)
VITE_TURNSTILE_SITE_KEY=

# Server-side only — NO VITE_ prefix (never bundled). Used by scripts/db.mjs and scripts/security-test.mjs
SUPABASE_DB_PASSWORD=
# Optional: session pooler host (Project → Connect → Session pooler)
# SUPABASE_DB_HOST=aws-1-eu-west-3.pooler.supabase.com
